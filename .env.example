NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=INFO
NEXUS_DATABASE_URL=postgresql://nexusos:nexusos@postgres:5432/nexusos
NEXUS_REDIS_URL=redis://redis:6379/0
NEXUS_QDRANT_URL=http://qdrant:6333
NEXUS_NATS_URL=nats://nats:4222
NEXUS_OBJECT_STORE_URL=http://minio:9000
NEXUS_OBJECT_STORE_ACCESS_KEY=nexusos
NEXUS_OBJECT_STORE_SECRET_KEY=nexusos-development-only
NEXUS_OTLP_ENDPOINT=http://otel-collector:4318
NEXUS_MODEL_BASE_URL=http://host.docker.internal:11434/v1
NEXUS_MODEL_API_KEY=local-development
# Set a real served model name to enable PRD generation. Empty disables generation.
NEXUS_MODEL_NAME=
NEXUS_PRD_DATABASE=./data/prd.sqlite3
NEXUS_PRD_CONTEXT_TOKENS=64000
NEXUS_PRD_OUTPUT_TOKENS=14000
