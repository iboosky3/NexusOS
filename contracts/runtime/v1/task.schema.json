{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexusos.net.cn/contracts/runtime/v1/task.schema.json",
  "title": "NexusOS Runtime Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run_id", "idempotency_key", "payload"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "maximum_attempts": {"type": "integer", "minimum": 0, "maximum": 10},
    "timeout_milliseconds": {"type": "integer", "minimum": 0, "maximum": 300000}
  }
}
